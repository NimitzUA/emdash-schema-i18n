{
  "name": "emdash-schema-i18n",
  "version": "1.2.3",
  "description": "Dynamic schema, collections, and block types localization for EmDash CMS Admin UI",
  "author": {
    "name": "Serhii Parshyn",
    "email": "serhii@parshyn.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/NimitzUA/emdash-schema-i18n.git"
  },
  "bugs": {
    "url": "https://github.com/NimitzUA/emdash-schema-i18n/issues"
  },
  "homepage": "https://github.com/NimitzUA/emdash-schema-i18n#readme",
  "keywords": [
    "emdash",
    "emdash-plugin",
    "i18n",
    "localization",
    "schema",
    "admin-ui"
  ],
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "emdash-schema-i18n": "./bin/cli.mjs"
  },
  "type": "module",
  "main": "./src/index.mjs",
  "types": "./src/index.d.mts",
  "exports": {
    ".": {
      "types": "./src/index.d.mts",
      "import": "./src/index.mjs"
    },
    "./middleware": {
      "types": "./src/middleware.d.mts",
      "import": "./src/middleware.mjs"
    },
    "./admin": {
      "types": "./src/admin/index.d.ts",
      "import": "./src/admin/index.js"
    }
  },
  "files": [
    "src",
    "bin",
    "test",
    "emdash-plugin.jsonc",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "prepack": "npm run build",
    "test": "node --test test/*.test.mjs",
    "test:live": "node --test test/e2e-live.test.mjs",
    "example:init": "cd example && npx emdash secrets generate --write .env && npx emdash init && npx emdash seed seed/seed.json --on-conflict=update",
    "example:dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev --root example --host 127.0.0.1 --port 4321",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22.16"
  },
  "peerDependencies": {
    "@emdash-cms/admin": ">=1.2.0 <2.0.0",
    "@lingui/react": ">=4.0.0 <6.0.0",
    "astro": ">=6.0.0 <8.0.0",
    "emdash": ">=1.0.1 <2.0.0",
    "react": ">=18.0.0 <20.0.0",
    "react-dom": ">=18.0.0 <20.0.0"
  },
  "devDependencies": {
    "@astrojs/node": "^11.1.8",
    "@types/react": "^19.0.0",
    "typescript": "^5.0.0"
  }
}
